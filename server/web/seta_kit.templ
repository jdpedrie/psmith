package web

// Parts the settings-a pages share: the page head, segmented controls, chip
// toggles and the icons the shared icon set doesn't carry.

type saCrumb struct {
	Label, Href string
}

// saHead is the top of a settings page: breadcrumb, title, the actions beside
// it and a lede. Back is where the phone header's back link goes; it defaults
// to the last crumb.
type saHead struct {
	Crumbs  []saCrumb
	Title   string
	Lede    string
	Actions templ.Component
	Tail    templ.Component // inside the title row, after the lede
}

func (h saHead) back() saCrumb {
	if len(h.Crumbs) == 0 {
		return saCrumb{Label: "Settings", Href: "/settings"}
	}
	return h.Crumbs[len(h.Crumbs)-1]
}

templ saIcon(name string) {
	switch name {
		case "chev":
			<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5"></path></svg>
		case "chev12":
			<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5"></path></svg>
		case "plus12":
			<svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M6 1.5v9M1.5 6h9"></path></svg>
		case "x10":
			<svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2 2l6 6M8 2l-6 6"></path></svg>
		case "check10":
			<svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 5.2l2 2 4-4.4"></path></svg>
		case "reset":
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 7a5 5 0 1 1-1.5-3.6"></path><path d="M12 1.5v3h-3"></path></svg>
		case "search15":
			<svg width="15" height="15" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="6" cy="6" r="4.4"></circle><path d="M9.4 9.4L13 13"></path></svg>
		case "star":
			<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M8 1.8l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.6l-3.8 2 .7-4.3-3.1-3 4.3-.6z"></path></svg>
		case "staroff":
			<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M8 1.8l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.6l-3.8 2 .7-4.3-3.1-3 4.3-.6z"></path></svg>
		case "lock":
			<svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><rect x="2.5" y="5.5" width="7" height="5" rx="1.2"></rect><path d="M4 5.5V4a2 2 0 0 1 4 0v1.5"></path></svg>
		case "more":
			<svg width="16" height="4" viewBox="0 0 14 4" fill="currentColor" aria-hidden="true"><circle cx="2" cy="2" r="1.4"></circle><circle cx="7" cy="2" r="1.4"></circle><circle cx="12" cy="2" r="1.4"></circle></svg>
	}
}

// saPageHead renders the breadcrumb, title row and lede. On a phone the
// breadcrumb gives way to a back header.
templ saPageHead(h saHead) {
	<div class="phead">
		<header class="pback">
			<a href={ templ.SafeURL(h.back().Href) }>
				@icon("back")
				{ h.back().Label }
			</a>
		</header>
		<nav class="crumbs" aria-label="Breadcrumb">
			for _, c := range h.Crumbs {
				<a href={ templ.SafeURL(c.Href) }>{ c.Label }</a>
				{ " / " }
			}
			{ h.Title }
		</nav>
		<div class="page-title">
			<h2>{ h.Title }</h2>
			if h.Actions != nil {
				@h.Actions
			}
			if h.Lede != "" {
				<p class="lede">{ h.Lede }</p>
			}
			if h.Tail != nil {
				@h.Tail
			}
		</div>
		{ children... }
	</div>
}

type saOpt struct {
	Value, Label string
}

// saSegs is a segmented control over real radio inputs, so it posts without
// script and the save bar can count it.
templ saSegs(name, label, cur string, opts []saOpt) {
	<div class="seg" role="radiogroup" aria-label={ label }>
		for _, o := range opts {
			<label>
				<input type="radio" name={ name } value={ o.Value } checked?={ o.Value == cur }/>
				{ o.Label }
			</label>
		}
	</div>
}

type saTog struct {
	Value, Label string
	On           bool
}

// saTogs is a row of chip toggles over checkboxes sharing a name.
templ saTogs(name string, opts []saTog) {
	<span class="togs">
		for _, o := range opts {
			<label class="tog">
				<input type="checkbox" name={ name } value={ o.Value } checked?={ o.On }/>
				{ o.Label }
			</label>
		}
	</span>
}

// saResult is a one-line outcome under a title or in a row.
templ saResult(r *testVM) {
	if r != nil {
		<p role="status" class={ "result", templ.KV("bad", !r.OK) }><span class="dot"></span>{ r.Message }</p>
	}
}
