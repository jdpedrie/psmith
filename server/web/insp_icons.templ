package web

// ii holds the inspector's glyphs that icons.templ doesn't: the boards draw
// them at these sizes.
templ ii(name string) {
	switch name {
		case "reset":
			<svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M2 7a5 5 0 1 0 1.5-3.6"></path><path d="M2 1.5v3h3"></path></svg>
		case "star":
			<svg width="13" height="13" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><path d="M7 1.2l1.75 3.6 3.95.55-2.87 2.77.7 3.93L7 10.2l-3.53 1.85.7-3.93L1.3 5.35l3.95-.55z"></path></svg>
		case "check":
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 7.2l3 3 6-6.4"></path></svg>
		case "plus13":
			<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M8 3v10M3 8h10"></path></svg>
		case "edit14":
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 2l2.5 2.5L5 11.5H2.5V9z"></path></svg>
		case "trash14":
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><path d="M2 3.5h10M5.5 3.5V2h3v1.5M3.5 3.5l.6 8.5h5.8l.6-8.5"></path></svg>
		case "pin":
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 1.5h4M5.8 1.5v4L3.5 8h7L8.2 5.5v-4M7 8v4.5"></path></svg>
		case "archive":
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><rect x="1.5" y="2" width="11" height="3" rx="1"></rect><path d="M2.5 5v6a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1V5M5.5 7.5h3"></path></svg>
		case "eye":
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M1 7s2.2-4.2 6-4.2S13 7 13 7s-2.2 4.2-6 4.2S1 7 1 7z"></path><circle cx="7" cy="7" r="1.8"></circle></svg>
		case "warn":
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 1.8l5.6 10H1.4z"></path><path d="M7 5.8v2.6M7 10.2v.1"></path></svg>
		case "key":
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="4.5" cy="9.5" r="3"></circle><path d="M6.6 7.4L12.5 1.5M10.5 3.5l1.6 1.6M8.8 5.2l1.4 1.4"></path></svg>
		case "regen14":
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 7a5 5 0 1 1-1.5-3.6"></path><path d="M12 1.5v3h-3"></path></svg>
		case "chev":
			<svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3.5 2l3 3-3 3"></path></svg>
	}
}
