package web

// defaultsPageVM is a full CallSettings editor: a provider's defaults, or one
// model's own layer above them.
type defaultsPageVM struct {
	Crumbs   []saCrumb
	Title    string
	Lede     string
	Action   string
	Level    string // "provider" or "model"
	ProvName string
	ProvType string
	F        csForm
	Inh      csForm            // what an unset field inherits (model level)
	TempLock string            // the only temperature the model takes (model level)
	Prev     map[string]string // field name -> value it had, for fields arriving dirty
	Dirty    int
	Error    string
}

func (d defaultsPageVM) tempHint() string {
	if d.ProvType == "anthropic" {
		return "0 to 1"
	}
	return "0 to 2"
}

// hint is what sits beside an unset field: what it inherits, or its range.
func (d defaultsPageVM) hint(inherited, rng string) string {
	if d.Level == "model" && inherited != "" {
		return "Inherits " + inherited + " from " + d.ProvName
	}
	return rng
}

func (d defaultsPageVM) unused(block string) bool {
	switch block {
	case "anthropic":
		return d.ProvType != "anthropic"
	case "openai":
		return d.ProvType != "openai-compatible"
	case "google":
		return d.ProvType != "google"
	}
	return false
}

var (
	optsEffort   = []saOpt{{"", "Not set"}, {"off", "Off"}, {"low", "Low"}, {"medium", "Medium"}, {"high", "High"}, {"xhigh", "Extra high"}}
	optsOnOff    = []saOpt{{"", "Not set"}, {"on", "On"}, {"off", "Off"}}
	optsPCache   = []saOpt{{"", "Not set (on)"}, {"on", "On"}, {"off", "Off"}}
	optsTTL      = []saOpt{{"", "Not set (5 min)"}, {"5m", "5 min"}, {"1h", "1 hour"}}
	optsTier     = []saOpt{{"", "Not set"}, {"auto", "Auto"}, {"standard", "Standard"}, {"priority", "Priority"}}
	optsRFmt     = []saOpt{{"", "Not set"}, {"text", "Text"}, {"json_object", "JSON object"}, {"json_schema", "JSON schema"}}
	optsHarm     = []saOpt{{"", "Not set"}, {"none", "Block none"}, {"low", "Low and up"}, {"medium", "Medium and up"}, {"high", "High only"}}
	choiceLabels = map[string]string{"": "Not set", "on": "On", "off": "Off", "5m": "5 min", "1h": "1 hour"}
)

// saRowTail is what follows a field: a changed note, a reset button for a set
// value, or the hint.
templ saRowTail(d defaultsPageVM, name, label, val, hint string) {
	if prev, ok := d.Prev[name]; ok {
		<span class="changed">{ "Changed from " + prev }</span>
	} else if val != "" {
		<button class="reset" type="button" data-reset={ name } aria-label={ "Reset " + label + " to not set" } title="Reset to not set">
			@saIcon("reset")
		</button>
	} else if hint != "" {
		<span class="hint">{ hint }</span>
	}
}

templ saNumRow(d defaultsPageVM, id, name, label, val, hint, help string) {
	<div class="grow">
		<label for={ id } class="lbl">{ label }</label>
		<input id={ id } name={ name } class="field num" inputmode="decimal" placeholder="Not set" value={ val }/>
		@saRowTail(d, name, label, val, hint)
		if help != "" {
			<p class="help">{ help }</p>
		}
	</div>
}

templ saSegRow(d defaultsPageVM, id, name, label, val string, opts []saOpt, help string) {
	<div class="grow">
		<span id={ id } class="lbl">{ label }</span>
		@saSegs(name, label, val, opts)
		@saRowTail(d, name, label, val, "")
		if help != "" {
			<p class="help">{ help }</p>
		}
	</div>
}

templ saSelRow(d defaultsPageVM, id, name, label, val string, opts []saOpt) {
	<div class="grow">
		<label for={ id } class="lbl">{ label }</label>
		<select id={ id } name={ name } class="field sel">
			for _, o := range opts {
				<option value={ o.Value } selected?={ o.Value == val }>{ o.Label }</option>
			}
		</select>
	</div>
}

templ saLineage(d defaultsPageVM) {
	<ol class="lineage" aria-label="Where call settings come from, lowest first">
		<li class={ templ.KV("on", d.Level == "provider") }>{ d.ProvName + " defaults" }</li>
		<li class="arr" aria-hidden="true">
			@saIcon("chev12")
		</li>
		<li class={ templ.KV("on", d.Level == "model") }>Model</li>
		<li class="arr" aria-hidden="true">
			@saIcon("chev12")
		</li>
		<li>Profile</li>
		<li class="arr" aria-hidden="true">
			@saIcon("chev12")
		</li>
		<li>Conversation</li>
	</ol>
}

templ extrasBlock(d defaultsPageVM, block, id, title string) {
	if d.unused(block) {
		<section aria-labelledby={ id }>
			<details class="group xdetails" open?={ extrasSet(d.F, block) }>
				<summary id={ id }>
					<span class="dis">
						@saIcon("chev12")
					</span>
					<span class="st">{ title }</span>
					<span class="hint">{ "Not used by " + d.ProvName + " models" }</span>
				</summary>
				<div class="xbody">
					@extrasRows(d, block)
				</div>
			</details>
		</section>
	} else {
		<section aria-labelledby={ id }>
			<h3 id={ id } class="sec-title">{ title }</h3>
			<div class="group">
				@extrasRows(d, block)
			</div>
		</section>
	}
}

templ extrasRows(d defaultsPageVM, block string) {
	switch block {
		case "anthropic":
			@saSegRow(d, "pcache", "cache_enabled", "Prompt caching", d.F.PCache, optsPCache, "When off, no cache_control marker is sent. Useful for one-off conversations or privacy.")
			@saSegRow(d, "ttl", "cache_ttl", "Cache TTL", d.F.TTL, optsTTL, "1 hour costs more to write but survives stop-and-resume work.")
		case "openai":
			@saNumRow(d, "seed", "seed", "Seed", d.F.Seed, d.hint(d.Inh.Seed, "-1,000,000 to 1,000,000"), "Same seed and inputs ask for the same reply. Best effort.")
			@saNumRow(d, "freq", "frequency_penalty", "Frequency penalty", d.F.Freq, d.hint(d.Inh.Freq, "-2 to 2"), "Discourages repeating the same tokens.")
			@saNumRow(d, "pres", "presence_penalty", "Presence penalty", d.F.Pres, d.hint(d.Inh.Pres, "-2 to 2"), "Encourages new topics.")
			@saNumRow(d, "logp", "top_logprobs", "Top logprobs", d.F.Logp, d.hint(d.Inh.Logp, "0 to 5"), "Returns the likeliest alternatives for each token.")
			@saSegRow(d, "ptc", "parallel_tool_calls", "Parallel tool calls", d.F.PTC, optsOnOff, "Lets the model call several tools in one turn.")
			@saSegRow(d, "tier", "service_tier", "Service tier", d.F.Tier, optsTier, "Priority costs more and answers faster.")
			@saSegRow(d, "rfmt", "response_format", "Response format", d.F.RFmt, optsRFmt, "JSON schema adds name, description, strict and schema fields.")
			<div class="schema-fields" data-when="response_format=json_schema" hidden?={ d.F.RFmt != "json_schema" }>
				<div class="grow">
					<label for="sname" class="lbl">Schema name</label>
					<input id="sname" name="schema_name" class="field wide" value={ d.F.SchemaName }/>
				</div>
				<div class="grow">
					<label for="sdesc" class="lbl">Schema description</label>
					<input id="sdesc" name="schema_description" class="field wide" value={ d.F.SchemaDesc }/>
				</div>
				<div class="grow">
					<label for="sjson" class="lbl">Schema</label>
					<textarea id="sjson" name="schema" class="field area">{ d.F.Schema }</textarea>
				</div>
				<div class="grow">
					<label for="sstrict" class="lbl fill">Strict</label>
					<input id="sstrict" type="checkbox" name="schema_strict" value="on" checked?={ d.F.SchemaStrict }/>
				</div>
			</div>
			<div class="grow">
				<label for="bias" class="lbl">Logit bias</label>
				<textarea id="bias" name="logit_bias" class="field area" placeholder={ `{ "50256": -100 }` }>{ d.F.Bias }</textarea>
				<p class="help">Token ID to bias, from -100 to 100. Token IDs depend on the model.</p>
			</div>
		case "google":
			@saSelRow(d, "harass", "harassment", "Harassment", d.F.Harass, optsHarm)
			@saSelRow(d, "hate", "hate_speech", "Hate speech", d.F.Hate, optsHarm)
			@saSelRow(d, "sex", "sexually_explicit", "Sexually explicit", d.F.Sex, optsHarm)
			@saSelRow(d, "danger", "dangerous_content", "Dangerous content", d.F.Dang, optsHarm)
			<div class="grow">
				<label for="mime" class="lbl">Response MIME type</label>
				<input id="mime" name="response_mime_type" class="field wide mono" placeholder="Not set" value={ d.F.Mime }/>
				<p class="help">For example application/json.</p>
			</div>
			<div class="grow">
				<label for="rschema" class="lbl">Response schema</label>
				<textarea id="rschema" name="response_schema" class="field area" placeholder="JSON Schema">{ d.F.RSchema }</textarea>
				<p class="help">The reply must match this schema.</p>
			</div>
			@saNumRow(d, "cand", "candidate_count", "Candidate count", d.F.Cand, d.hint(d.Inh.Cand, "1 to 8"), "How many replies to generate.")
	}
}

func extrasSet(f csForm, block string) bool {
	switch block {
	case "anthropic":
		return f.PCache != "" || f.TTL != ""
	case "openai":
		return f.Seed != "" || f.Freq != "" || f.Pres != "" || f.Logp != "" || f.PTC != "" || f.Tier != "" || f.RFmt != "" || f.Bias != ""
	case "google":
		return f.Harass != "" || f.Hate != "" || f.Sex != "" || f.Dang != "" || f.Mime != "" || f.RSchema != "" || f.Cand != ""
	}
	return false
}

// callSettingsFields is every CallSettings field, grouped the way the
// defaults page draws them. The add-model page reuses it.
templ callSettingsFields(d defaultsPageVM) {
	<section aria-labelledby="common">
		<h3 id="common" class="sec-title">Common</h3>
		<div class="group">
			if d.TempLock != "" {
				@saLockedRow("temp", "Temperature", d.TempLock, "This model locks temperature at "+d.TempLock+".")
			} else {
				@saNumRow(d, "temp", "temperature", "Temperature", d.F.Temp, d.hint(d.Inh.Temp, d.tempHint()), "Sampling temperature. "+d.ProvName+" clamps it to "+d.tempHint()+".")
			}
			@saNumRow(d, "topp", "top_p", "Top P", d.F.TopP, d.hint(d.Inh.TopP, "0 to 1"), "Nucleus sampling cutoff. Lower values keep the reply on the likeliest tokens.")
			@saNumRow(d, "maxtok", "max_output_tokens", "Max output tokens", d.F.MaxTok, d.hint(d.Inh.MaxTok, ""), "Hard cap on tokens the model can write in one turn.")
			@saNumRow(d, "topk", "top_k", "Top K", d.F.TopK, d.hint(d.Inh.TopK, "1 to 500"), "Sample from the top K tokens only. Anthropic and Google honour it; other providers ignore it.")
			<div class="grow">
				<label for="stop" class="lbl">Stop sequences</label>
				<span class="stops" data-stops>
					for _, s := range d.F.Stops {
						<span class="stopchip">
							{ s }
							<input type="hidden" name="stop" value={ s }/>
							<button type="button" data-stop-remove aria-label={ "Remove stop sequence " + s }>
								@saIcon("x10")
							</button>
						</span>
					}
					<input id="stop" name="stop_new" class="field mono stopin" placeholder="Add stop sequence" data-stop-add/>
				</span>
				<p class="help">Strings that end the reply when the model writes them. Press Return to add one.</p>
			</div>
		</div>
	</section>
	<section aria-labelledby="thinking">
		<h3 id="thinking" class="sec-title">Thinking</h3>
		<div class="group">
			@saSegRow(d, "effort", "effort", "Effort", d.F.Effort, optsEffort, "How hard the model reasons before answering. Off is honoured where the model can stop; elsewhere it means the lowest level.")
		</div>
	</section>
	<section aria-labelledby="caching">
		<h3 id="caching" class="sec-title">Caching</h3>
		<div class="group">
			@saSegRow(d, "xcache", "explicit_cache", "Explicit caching", d.F.Explicit, optsOnOff, "On Anthropic, raises the cache lifetime from 5 minutes to 1 hour. On Google, places cached content for you, billed per hour. Elsewhere it does nothing.")
		</div>
	</section>
	@extrasBlock(d, "anthropic", "anth", "Anthropic extras")
	@extrasBlock(d, "openai", "oai", "OpenAI extras")
	@extrasBlock(d, "google", "goog", "Google extras")
}

templ defaultsScreen(n snavVM, d defaultsPageVM) {
	@settingsScreen(d.Title, n) {
		<form class="spage-form seta" method="post" action={ templ.SafeURL(d.Action) }>
			<div class="spage-scroll">
				<div class="spage-inner">
					@saPageHead(saHead{Crumbs: d.Crumbs, Title: d.Title, Lede: d.Lede, Tail: saLineage(d)}) {
						if d.Error != "" {
							<p role="alert" class="result bad"><span class="dot"></span>{ d.Error }</p>
						}
					}
					@callSettingsFields(d)
				</div>
			</div>
			@saveBar(d.Dirty)
		</form>
	}
}
