package web

// The conversation's own glyphs, as the boards draw them. Shared glyphs live
// in icons.templ.
templ convIcon(name string) {
	switch name {
		case "more":
			<svg width="15" height="4" viewBox="0 0 14 4" fill="currentColor" aria-hidden="true"><circle cx="2" cy="2" r="1.4"></circle><circle cx="7" cy="2" r="1.4"></circle><circle cx="12" cy="2" r="1.4"></circle></svg>
		case "down":
			<svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 2v10M2.5 7.5L7 12l4.5-4.5"></path></svg>
		case "disclosed":
			<svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 3.5l3 3 3-3"></path></svg>
		case "collapse":
			<svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 6.5l3-3 3 3"></path></svg>
		case "markdown":
			<svg width="15" height="15" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="12" height="8" rx="1.5"></rect><path d="M3.5 9V5l1.5 1.8L6.5 5v4M9.5 5v4M8.2 7.8l1.3 1.2 1.3-1.2"></path></svg>
		case "text":
			<svg width="15" height="15" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><path d="M2 3h10M2 6h10M2 9h10M2 12h6"></path></svg>
		case "check":
			<svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 7.5l3 3 6-7"></path></svg>
		case "warn":
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M7 1.8l5.6 10H1.4z"></path><path d="M7 5.6v3M7 10.3v.1"></path></svg>
		case "retry":
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 7a5 5 0 1 1-1.5-3.6"></path><path d="M12 1.5v3h-3"></path></svg>
		case "file":
			<svg width="15" height="15" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 1h4.5l2.5 2.5V11h-7z"></path><path d="M7 1v2.5h2.5"></path></svg>
		case "file12":
			<svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 1h4.5l2.5 2.5V11h-7z"></path><path d="M7 1v2.5h2.5"></path></svg>
		case "back15":
			<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3L5 8l5 5"></path></svg>
		case "download":
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 1.5v8M3.5 6L7 9.5 10.5 6M2 12.5h10"></path></svg>
		case "image28":
			<svg width="28" height="28" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="1" y="1.5" width="10" height="9" rx="1.5"></rect><path d="M1.5 8.5l3-3 2.5 2.5L8.5 6.5l2 2"></path></svg>
		case "drop":
			<svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 4v13M7.5 11.5L13 17l5.5-5.5"></path><path d="M4 18v2.5A1.5 1.5 0 0 0 5.5 22h15a1.5 1.5 0 0 0 1.5-1.5V18"></path></svg>
		case "continue":
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 2v4.5a2 2 0 0 0 2 2h7"></path><path d="M9 6l2.5 2.5L9 11"></path></svg>
		case "edit13":
			<svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 2l2.5 2.5L5 11.5H2.5V9z"></path></svg>
		case "lock":
			<svg width="11" height="11" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="2.5" y="6" width="9" height="6.5" rx="1.5"></rect><path d="M4.5 6V4.3a2.5 2.5 0 0 1 5 0V6"></path></svg>
		case "sparkle":
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d="M6 1.5l1.2 3.3 3.3 1.2-3.3 1.2L6 10.5 4.8 7.2 1.5 6l3.3-1.2z"></path><path d="M11 9l.6 1.4 1.4.6-1.4.6L11 13l-.6-1.4L9 11l1.4-.6z"></path></svg>
		case "external":
			<svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M8 2h4v4M12 2L6.5 7.5"></path><path d="M10.5 8.5v3a1 1 0 0 1-1 1h-7a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h3"></path></svg>
	}
}
